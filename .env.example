# Copy this file to `.env` in the repo root before running
# `docker-compose up --build`. Every value below has a dev-safe default baked
# into docker-compose.yml / application-dev.yml, so `.env` is optional for
# local development — but every variable a real deployment needs is listed
# here. NEVER commit a `.env` file with real secrets (it's already
# gitignored).

# --- MySQL --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=devRootPass123

# --- Backend: Spring profile ---------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- Backend: DB connection (used directly when running `mvn spring-boot:run`
# outside Docker; inside docker-compose these are wired to the `db` service
# automatically) ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bankapp
DB_USERNAME=root
DB_PASSWORD=devRootPass123

# --- Backend: JWT ----------------------------------------------------------
# Base64-encoded, >=256-bit secret. Generate your own for anything beyond
# local dev, e.g.: openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2QtMDEyMzQ1Njc4OQ==
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Backend: PAN encryption / hashing --------------------------------------
# PAN_ENCRYPTION_KEY: base64-encoded 256-bit AES key. Generate your own, e.g.:
#   openssl rand -base64 32
PAN_ENCRYPTION_KEY=ZGV2LXBhbi1hZXMyNTYta2V5LTMyLWJ5dGVzLW9rISE=
# PAN_HASH_PEPPER: any long random string, kept secret and DIFFERENT from
# PAN_ENCRYPTION_KEY.
PAN_HASH_PEPPER=dev-only-pan-hash-pepper-change-me

# --- Backend: credit bureau integration -------------------------------------
# "mock" (default, no credentials needed) or "real" (requires an actual
# bureau licensing/API agreement — see docs/COMPLIANCE_BOUNDARIES.md).
BUREAU_PROVIDER=mock
BUREAU_BASE_URL=
BUREAU_CLIENT_ID=
BUREAU_CLIENT_SECRET=
BUREAU_MEMBER_ID=
BUREAU_TIMEOUT_MS=5000

# --- Frontend ----------------------------------------------------------------
# Base URL the frontend calls for the API. In docker-compose, the frontend's
# nginx reverse-proxies /api/ to the backend service, so the same-origin
# relative path below is correct and does not need to change. For local
# `npm run dev` against a backend on localhost:8080, use the absolute form
# instead: VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=/api
